# Loopback tour
#
# Shows:   both sides in one script — a venue, a client and a minder — over the
#          loopback sessions; between them they use every kind of block
# Needs:   the loopback sessions, both started (Help > Scenario Examples sets
#          them up); nothing else armed
# Watch:   all four order and trade blotters, and Scenario Scripts
# Outcome: five orders go out at two a second; the venue accepts each, fills it
#          in two clips, refuses replaces that come after the first and honours
#          cancels; each client script chases once, then cancels what is left
#          and passes

scenario loopback-tour
seed 1
on error continue

# ── the venue ────────────────────────────────────────────────────────────
on order where session_id == 'LOOP-MKT'
    after 100ms ± 20ms
    accept text: 'working'

    when replace and order.orig_cl_ord_id != ''
        reject text: 'one replace per order'
    when replace
        accept
    when cancel
        accept
        stop
    when dk
        renotify
    when error
        log 'venue refused: ${event.text}'

    repeat 2 every 1s
        if order.leaves_qty > 0
            fill qty: CEIL(order.leaves_qty / 2), price: order.price

# ── the client ───────────────────────────────────────────────────────────
run on LOOP-CLI
    repeat 5 at 2/s with sym = ['IBM', 'MSFT']
        new symbol: sym, side: buy, qty: 100 * (n + 1), type: limit, price: 25.00
        expect ack within 2s else fail 'no acknowledgement'

        wait fill or timeout 3s
        if order.pending_action == '' and order.leaves_qty > 0
            replace qty: order.order_qty + 100
            wait replaced or cancel rejected or timeout 2s

        wait filled or timeout 2s
        if order.leaves_qty > 0
            cancel
            expect canceled or filled within 2s
        pass '${sym}: ${order.cum_qty} done'

# ── the minder: anything sent by hand on the client session ────────────────
on sent order where session_id == 'LOOP-CLI'
    expect ack within 2s
    after 10s
    if order.leaves_qty > 0
        cancel
