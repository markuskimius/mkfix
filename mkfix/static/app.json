{
  "app": {
    "title": "mkfix — FIX Protocol Testing Engine",
    "theme": "dark"
  },
  "state": {
    "status": { "message": "Connecting...", "background": "#858585", "color": "#000" },
    "selected_session": null,
    "selected_message": null
  },
  "menubar": [
    {
      "label": "Edit",
      "items": [
        { "label": "Copy", "action": "edit.copy", "shortcut": "mod+C" },
        { "label": "Select All", "action": "edit.selectAll", "shortcut": "mod+A" }
      ]
    },
    {
      "label": "Sessions",
      "items": [
        { "label": "Session Manager", "action": "pane.show", "args": "session-manager" }
      ]
    },
    {
      "label": "Messages",
      "items": [
        { "label": "Messages", "action": "pane.show", "args": "raw-messages" },
        { "label": "Detail", "action": "pane.show", "args": "message-detail" }
      ]
    },
    {
      "label": "Trading",
      "items": [
        { "label": "Sent Orders", "action": "pane.show", "args": "order-blotter" },
        { "label": "Received Trades", "action": "pane.show", "args": "trade-blotter" },
        { "sep": true },
        { "label": "Received Orders", "action": "pane.show", "args": "market-order-blotter" },
        { "label": "Sent Trades", "action": "pane.show", "args": "market-trade-blotter" }
      ]
    },
    {
      "label": "Tools",
      "items": [
        { "label": "IOIs", "action": "pane.show", "args": "ioi-viewer" },
        { "label": "Allocations", "action": "pane.show", "args": "allocation-viewer" },
        { "sep": true },
        { "label": "Replay Control", "action": "pane.show", "args": "replay-control" }
      ]
    },
    {
      "label": "Window",
      "items": [
        { "label": "Tile Horizontal", "action": "window.tileH" },
        { "label": "Tile Vertical", "action": "window.tileV" },
        { "label": "Grid", "action": "window.grid" },
        { "label": "Cascade", "action": "window.cascade" },
        { "sep": true },
        { "windows": true }
      ]
    }
  ],
  "statusbar": {
    "left": [
      { "type": "text", "bind": "status.message" }
    ],
    "right": [
      { "type": "text", "text": "mkfix v0.8" }
    ],
    "bindStyle": { "color": "status.color", "background": "status.background" }
  },
  "panes": {
    "session-manager": {
      "title": "Sessions",
      "type": "session-manager"
    },
    "raw-messages": {
      "title": "Messages",
      "type": "mkio-table",
      "service": "messages_stream",
      "protocol": "stream",
      "start": "today",
      "live": true,
      "columns": ["timestamp", "direction", "seq_num", "session_id", "msg_type_name", "raw_message"],
      "labels": { "timestamp": "Time", "direction": "Dir", "seq_num": "Seq", "session_id": "Session", "msg_type_name": "Type", "raw_message": "Message" },
      "select": { "state": "selected_message" }
    },
    "message-detail": {
      "title": "Detail",
      "type": "message-detail"
    },
    "order-blotter": {
      "title": "Sent Orders",
      "type": "mkio-table",
      "service": "orders_query",
      "protocol": "query",
      "filter": "direction == 'TX'",
      "columns": ["order_id", "cl_ord_id", "session_id", "symbol", "side", "ord_type", "price", "order_qty", "status", "cum_qty", "avg_price", "leaves_qty", "updated_at"],
      "labels": { "order_id": "Order ID", "cl_ord_id": "ClOrdID", "session_id": "Session", "symbol": "Symbol", "side": "Side", "ord_type": "Type", "price": "Price", "order_qty": "Qty", "status": "Status", "cum_qty": "Cum Qty", "avg_price": "Avg Px", "leaves_qty": "Leaves", "updated_at": "Updated" },
      "buttons": [
        {
          "label": "New",
          "enable": { "connected": true },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "New Order",
              "modal": true,
              "width": 420,
              "fields": [
                {
                  "name": "session_id",
                  "label": "Session",
                  "type": "select",
                  "optionsFrom": { "service": "sessions_list", "value": "session_id", "label": "session_id" },
                  "required": true
                },
                {
                  "row": [
                    { "name": "symbol", "label": "Symbol", "type": "text", "placeholder": "AAPL", "width": 0.5, "required": true },
                    { "name": "side", "label": "Side", "type": "select", "width": 0.5, "options": [
                      { "value": "1", "label": "Buy" },
                      { "value": "2", "label": "Sell" },
                      { "value": "5", "label": "Sell Short" }
                    ] }
                  ]
                },
                {
                  "row": [
                    { "name": "qty", "label": "Quantity", "type": "number", "placeholder": "100", "min": 1, "width": 0.5, "required": true },
                    { "name": "ord_type", "label": "Order Type", "type": "select", "width": 0.5, "options": [
                      { "value": "1", "label": "Market" },
                      { "value": "2", "label": "Limit" },
                      { "value": "3", "label": "Stop" },
                      { "value": "4", "label": "Stop Limit" }
                    ] }
                  ]
                },
                {
                  "row": [
                    { "name": "price", "label": "Price", "type": "number", "placeholder": "0.00", "step": "0.01", "width": 0.5 },
                    { "name": "tif", "label": "Time in Force", "type": "select", "width": 0.5, "options": [
                      { "value": "0", "label": "Day" },
                      { "value": "1", "label": "GTC" },
                      { "value": "3", "label": "IOC" },
                      { "value": "4", "label": "FOK" },
                      { "value": "6", "label": "GTD" }
                    ] }
                  ]
                },
                { "name": "account", "label": "Account", "type": "text", "placeholder": "Optional" }
              ],
              "submit": { "label": "Send Order", "service": "fix_cmd", "op": "send_new_order" }
            }
          }
        },
        {
          "label": "Replace",
          "unit": "row",
          "enable": { "connected": true, "rowMatch": { "status": ["PendingNew", "New", "PartiallyFilled", "Replaced"] } },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Cancel/Replace ${row.cl_ord_id}",
              "modal": true,
              "width": 380,
              "submitPerRow": true,
              "rowData": {
                "session_id": "${row.session_id}",
                "orig_cl_ord_id": "${row.cl_ord_id}",
                "symbol": "${row.symbol}",
                "side": "${row.side_code}",
                "ord_type": "${row.ord_type_code}"
              },
              "fields": [
                {
                  "row": [
                    { "name": "qty", "label": "Quantity", "type": "text", "value": "${row.order_qty}", "width": 0.5, "required": true },
                    { "name": "price", "label": "Price", "type": "text", "value": "${row.price}", "width": 0.5 }
                  ]
                }
              ],
              "submit": { "label": "Replace", "service": "fix_cmd", "op": "send_cancel_replace" }
            }
          }
        },
        {
          "label": "Cancel",
          "enable": { "connected": true, "minSelected": 1, "rowMatch": { "status": ["PendingNew", "New", "PartiallyFilled", "Replaced"] } },
          "action": {
            "type": "transaction",
            "service": "fix_cmd",
            "op": "send_cancel",
            "data": {
              "session_id": "${row.session_id}",
              "orig_cl_ord_id": "${row.cl_ord_id}",
              "symbol": "${row.symbol}",
              "side": "${row.side_code}",
              "qty": "${row.order_qty}"
            }
          }
        }
      ]
    },
    "trade-blotter": {
      "title": "Received Trades",
      "type": "mkio-table",
      "service": "executions_query",
      "protocol": "query",
      "filter": "direction == 'RX'",
      "columns": ["trade_id", "exec_id", "session_id", "symbol", "side", "last_qty", "last_price", "cum_qty", "avg_price", "exec_type", "transact_time"],
      "labels": { "trade_id": "Trade ID", "exec_id": "ExecID", "session_id": "Session", "symbol": "Symbol", "side": "Side", "last_qty": "Last Qty", "last_price": "Last Px", "cum_qty": "Cum Qty", "avg_price": "Avg Px", "exec_type": "Exec Type", "transact_time": "Time" }
    },
    "market-order-blotter": {
      "title": "Received Orders",
      "type": "mkio-table",
      "service": "orders_query",
      "protocol": "query",
      "filter": "direction == 'RX'",
      "columns": ["order_id", "cl_ord_id", "session_id", "symbol", "side", "ord_type", "price", "order_qty", "status", "pending_action", "pending_qty", "pending_price", "cum_qty", "avg_price", "leaves_qty", "updated_at"],
      "labels": { "order_id": "Order ID", "cl_ord_id": "ClOrdID", "session_id": "Session", "symbol": "Symbol", "side": "Side", "ord_type": "Type", "price": "Price", "order_qty": "Qty", "status": "Status", "pending_action": "Pending", "pending_qty": "New Qty", "pending_price": "New Px", "cum_qty": "Cum Qty", "avg_price": "Avg Px", "leaves_qty": "Leaves", "updated_at": "Updated" },
      "buttons": [
        {
          "label": "Accept",
          "enable": { "connected": true, "minSelected": 1, "rowMatch": { "pending_action": ["New", "Cancel", "Replace"] } },
          "action": {
            "type": "transaction",
            "service": "fix_cmd",
            "op": "accept_request",
            "data": {
              "session_id": "${row.session_id}",
              "cl_ord_id": "${row.cl_ord_id}"
            }
          }
        },
        {
          "label": "Reject",
          "unit": "row",
          "enable": { "connected": true, "rowMatch": { "pending_action": ["New", "Cancel", "Replace"] } },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Reject ${row.pending_action} ${row.cl_ord_id}",
              "modal": true,
              "width": 380,
              "submitPerRow": true,
              "rowData": {
                "session_id": "${row.session_id}",
                "cl_ord_id": "${row.cl_ord_id}"
              },
              "fields": [
                {
                  "row": [
                    { "name": "text", "label": "Reason", "type": "text", "value": "", "width": 1 }
                  ]
                }
              ],
              "submit": { "label": "Reject", "service": "fix_cmd", "op": "reject_request" }
            }
          }
        },
        {
          "label": "Fill",
          "unit": "row",
          "enable": { "connected": true, "rowMatch": { "status": ["New", "PartiallyFilled"] } },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Fill ${row.cl_ord_id}",
              "modal": true,
              "width": 380,
              "submitPerRow": true,
              "rowData": {
                "session_id": "${row.session_id}",
                "cl_ord_id": "${row.cl_ord_id}"
              },
              "fields": [
                {
                  "row": [
                    { "name": "qty", "label": "Quantity", "type": "text", "value": "${row.leaves_qty}", "width": 0.5, "required": true },
                    { "name": "price", "label": "Price", "type": "text", "value": "${row.price}", "width": 0.5, "required": true }
                  ]
                }
              ],
              "submit": { "label": "Fill", "service": "fix_cmd", "op": "fill_order" }
            }
          }
        }
      ]
    },
    "market-trade-blotter": {
      "title": "Sent Trades",
      "type": "mkio-table",
      "service": "executions_query",
      "protocol": "query",
      "filter": "direction == 'TX'",
      "columns": ["trade_id", "exec_id", "session_id", "symbol", "side", "last_qty", "last_price", "cum_qty", "avg_price", "exec_type", "transact_time"],
      "labels": { "trade_id": "Trade ID", "exec_id": "ExecID", "session_id": "Session", "symbol": "Symbol", "side": "Side", "last_qty": "Last Qty", "last_price": "Last Px", "cum_qty": "Cum Qty", "avg_price": "Avg Px", "exec_type": "Exec Type", "transact_time": "Time" },
      "buttons": [
        {
          "label": "Correct",
          "unit": "row",
          "enable": { "connected": true, "rowMatch": { "exec_type": ["PartialFill", "Fill", "Correct"] } },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Correct ${row.exec_id}",
              "modal": true,
              "width": 380,
              "submitPerRow": true,
              "rowData": {
                "session_id": "${row.session_id}",
                "exec_id": "${row.exec_id}"
              },
              "fields": [
                {
                  "row": [
                    { "name": "qty", "label": "Quantity", "type": "text", "value": "${row.last_qty}", "width": 0.5, "required": true },
                    { "name": "price", "label": "Price", "type": "text", "value": "${row.last_price}", "width": 0.5, "required": true }
                  ]
                }
              ],
              "submit": { "label": "Correct", "service": "fix_cmd", "op": "correct_trade" }
            }
          }
        },
        {
          "label": "Bust",
          "enable": { "connected": true, "minSelected": 1, "rowMatch": { "exec_type": ["PartialFill", "Fill", "Correct"] } },
          "action": {
            "type": "transaction",
            "service": "fix_cmd",
            "op": "bust_trade",
            "data": {
              "session_id": "${row.session_id}",
              "exec_id": "${row.exec_id}"
            }
          }
        }
      ]
    },
    "ioi-viewer": {
      "title": "IOIs",
      "type": "mkio-table",
      "service": "iois_query",
      "protocol": "query",
      "columns": ["ioi_id", "session_id", "ioi_trans_type", "symbol", "side", "ioi_qty", "price", "valid_until", "direction", "timestamp"],
      "labels": { "ioi_id": "IOI ID", "session_id": "Session", "ioi_trans_type": "Trans Type", "symbol": "Symbol", "side": "Side", "ioi_qty": "Qty", "price": "Price", "valid_until": "Valid Until", "direction": "Dir", "timestamp": "Time" }
    },
    "allocation-viewer": {
      "title": "Allocations",
      "type": "mkio-table",
      "service": "allocations_query",
      "protocol": "query",
      "columns": ["alloc_id", "session_id", "alloc_trans_type", "alloc_type", "symbol", "side", "quantity", "avg_price", "trade_date", "alloc_status", "num_allocs", "direction", "timestamp"],
      "labels": { "alloc_id": "AllocID", "session_id": "Session", "alloc_trans_type": "Trans Type", "alloc_type": "Alloc Type", "symbol": "Symbol", "side": "Side", "quantity": "Qty", "avg_price": "Avg Px", "trade_date": "Trade Date", "alloc_status": "Status", "num_allocs": "Allocs", "direction": "Dir", "timestamp": "Time" }
    },
    "replay-control": {
      "title": "Replay",
      "type": "replay-control"
    }
  },
  "frames": [
    {
      "id": "sessions",
      "x": 0.01, "y": 0.02, "w": 0.48, "h": 0.28,
      "layout": { "type": "tabs", "active": 0, "children": ["session-manager"] }
    },
    {
      "id": "messages",
      "x": 0.01, "y": 0.32, "w": 0.48, "h": 0.66,
      "layout": {
        "type": "split", "dir": "v", "ratios": [0.5, 0.5],
        "children": [
          { "type": "tabs", "active": 0, "children": ["raw-messages"] },
          { "type": "tabs", "active": 0, "children": ["message-detail"] }
        ]
      }
    },
    {
      "id": "client-trading",
      "x": 0.50, "y": 0.02, "w": 0.49, "h": 0.47,
      "layout": {
        "type": "split", "dir": "v", "ratios": [0.5, 0.5],
        "children": [
          { "type": "tabs", "active": 0, "children": ["order-blotter"] },
          { "type": "tabs", "active": 0, "children": ["trade-blotter"] }
        ]
      }
    },
    {
      "id": "market-trading",
      "x": 0.50, "y": 0.51, "w": 0.49, "h": 0.47,
      "layout": {
        "type": "split", "dir": "v", "ratios": [0.5, 0.5],
        "children": [
          { "type": "tabs", "active": 0, "children": ["market-order-blotter"] },
          { "type": "tabs", "active": 0, "children": ["market-trade-blotter"] }
        ]
      }
    }
  ],
  "mkio": {
    "url": "auto",
    "expect": { "name": "mkfix", "version": "0.8", "mkio": "0.1" },
    "connected": { "status.message": "Connected", "status.color": null, "status.background": null },
    "disconnected": { "status.message": "Disconnected", "status.color": "#000", "status.background": "#858585" },
    "incompatible": { "status.message": "Server version mismatch", "status.color": "#fff", "status.background": "#cc0000" }
  }
}
