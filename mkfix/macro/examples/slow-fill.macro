# Slow fill
#
# Shows:   while, timers with seeded jitter, partial fills, MIN, TICK, RANDOM
# Needs:   any session that receives orders
# Watch:   Received Orders: Cum Qty and Leaves; Sent Trades fills up
# Outcome: each order is worked in clips of up to 100 about once a second,
#          at or slightly through its limit, until nothing is left

macro slow-fill
seed 7                      # the same run, the same jitter and prices

on order where order_qty > 0
    after 200ms
    accept

    while order.leaves_qty > 0
        # ± is jitter either way; with a seed it repeats exactly.
        after 1s ± 250ms

        # Price improvement of 0 to 2 ticks, never floating-point noise.
        let improvement = TICK(RANDOM() * 0.02, 0.01)
        let px = IF(order.side_code == '1', order.price - improvement, order.price + improvement)

        fill qty: MIN(100, order.leaves_qty), price: TICK(px, 0.01)

    log 'done: ${order.cl_ord_id} avg ${order.avg_price}'
