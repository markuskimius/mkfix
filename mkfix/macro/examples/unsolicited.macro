# Unsolicited cancel and restate
#
# Shows:   the two things a market does to an order nobody asked for —
#          `restate` and `unsol cxl` — and restate reasons as words
# Needs:   any session that receives orders; FIX 4.2 or later for restate
# Watch:   Received Orders: Qty, Price and Status change with no request pending
# Outcome: day orders are cut to half after 3 s and pulled after 10 s;
#          good-till-cancel orders are repriced once and left working

macro unsolicited

on order
    accept

    # A `when` lives as long as the block it is written in, so this one sits
    # at the top: it must still be listening after the last line below has run.
    when cancel or replace and order.status == 'Canceled'
        reject text: 'order already canceled'

    if order.tif_code == '1'
        after 3s
        # A reason is a word, a quoted name or the FIX code: repricing, 'Repricing', '3'.
        restate qty: order.order_qty, price: TICK(order.price * 0.99, 0.01), reason: repricing
    else
        after 3s
        restate qty: order.order_qty / 2, reason: partial_decline, text: 'half declined'

        # Whatever is still open after ten seconds is pulled. A cancel or
        # replace request parked on the order stays parked, so the macro
        # can still refuse it as too late.
        after 7s
        if order.leaves_qty > 0
            unsol cxl text: 'end of session'
